{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rrouleau-x.github.io/tournament-content/_schemas/bundle-v1.json",
  "title": "Tournament Guide Bundle — Contract v1",
  "description": "The compiled data.json contract consumed by the Sporting Jax Guide PWA (app contract v1). Content modules compile into this shape. Fields marked required are mandatory for a publishable guide; everything else is optional and renders as an empty/absent state in the app.",
  "type": "object",
  "properties": {
    "sport": {
      "type": "string",
      "enum": ["soccer", "baseball", "basketball", "football", "lacrosse", "volleyball", "other"]
    },
    "sportConfig": {
      "type": "object",
      "description": "Sport-specific labels so the same app shell works for any sport.",
      "properties": {
        "teamLabel": { "type": "string" },
        "fieldLabel": { "type": "string" },
        "matchLabel": { "type": "string" },
        "uniformLabel": { "type": "string" },
        "cleatsLabel": { "type": "string" }
      },
      "required": ["teamLabel", "fieldLabel", "matchLabel"]
    },
    "tournament": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string" },
        "organizer": { "type": "string" },
        "dates": {
          "type": "object",
          "properties": {
            "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          "required": ["start", "end"]
        }
      },
      "required": ["name", "dates"]
    },
    "team": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string" },
        "colors": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "logo": { "type": "string" }
      },
      "required": ["name"]
    },
    "venue": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "mapsUrl": { "type": "string", "format": "uri" },
        "parking": { "type": "string" },
        "fields": {
          "type": "object",
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "surface": { "type": "string" },
            "map": { "type": "string", "format": "uri" },
            "layoutNotes": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "required": ["count"]
        },
        "amenities": {
          "type": "object",
          "properties": {
            "concessions": { "type": "boolean" },
            "restrooms": { "type": "boolean" },
            "shade": { "type": ["string", "boolean"] },
            "aed": { "type": "boolean" },
            "playground": { "type": "boolean" }
          }
        }
      },
      "required": ["name", "address"]
    },
    "games": {
      "type": "array",
      "description": "Empty until schedule releases. Each game follows the app's game card shape.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "time": { "type": "string" },
          "opponent": { "type": "string" },
          "venue": { "type": "string" },
          "field": { "type": "string" },
          "type": { "type": "string", "enum": ["group", "quarterfinal", "semifinal", "final", "showcase"] }
        }
      }
    },
    "scheduleStatus": {
      "type": "string",
      "enum": ["pending", "partial", "confirmed"]
    },
    "scheduleExpected": { "type": "string" },
    "hotels": {
      "type": "object",
      "properties": {
        "stayToPlay": { "type": "boolean" },
        "portal": { "type": "string", "format": "uri" },
        "official": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "chain": { "type": "string" },
              "rate": { "type": "string" },
              "total2Nights": { "type": "string" },
              "rooms": { "type": "integer", "minimum": 0 },
              "drive": { "type": "string", "pattern": "^\\d+(\\.\\d+)? mi · ~?\\d+ min$" },
              "route": { "type": "string" },
              "amenities": { "type": "array", "items": { "type": "string" } },
              "rating": { "type": "number", "minimum": 0, "maximum": 5 },
              "bestValue": { "type": "boolean" },
              "bookUrl": { "type": "string", "format": "uri" }
            },
            "required": ["name", "drive"]
          }
        },
        "nonOfficial": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "chain": { "type": "string" },
              "drive": { "type": "string", "pattern": "^\\d+(\\.\\d+)? mi · ~?\\d+ min$" },
              "note": { "type": "string" }
            },
            "required": ["name", "drive"]
          }
        }
      },
      "required": ["stayToPlay"]
    },
    "weather": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "forecastLink": { "type": "string" }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "fullLink": { "type": "string", "format": "uri" },
        "keyRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            },
            "required": ["label", "value"]
          }
        },
        "tiebreakers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["info", "warning", "alert", "success"] },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "time": { "type": "string" },
          "posted": { "type": "string" },
          "actionRequired": { "type": "boolean" }
        },
        "required": ["type", "title"]
      }
    },
    "contacts": {
      "type": "object",
      "properties": {
        "manager": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "role": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string", "format": "email" }
          }
        },
        "coach": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "role": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string", "format": "email" }
          }
        },
        "teamManagers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "phone": { "type": "string" },
              "email": { "type": "string", "format": "email" }
            }
          }
        },
        "premierStaff": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "phone": { "type": "string" }
            }
          }
        },
        "tournamentDirector": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string", "format": "email" },
            "phone": { "type": "string" }
          }
        },
        "emergency": { "type": "string" }
      }
    },
    "venueRules": {
      "type": "object",
      "properties": {
        "tents": { "type": "string" },
        "pets": { "type": "string" },
        "foodCooler": { "type": "string" },
        "chairs": { "type": "string" },
        "alcohol": { "type": "string" },
        "smoking": { "type": "string" }
      }
    },
    "checklist": {
      "type": "object",
      "properties": {
        "player": { "type": "array", "items": { "type": "string" } },
        "weather": { "type": "array", "items": { "type": "string" } },
        "parent": { "type": "array", "items": { "type": "string" } },
        "emergency": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nearby": {
      "type": "object",
      "description": "Nearby resources. Keys are semantic slugs (urgentCare, target, dicks, coffee); values are place objects.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "address": { "type": "string" },
          "phone": { "type": "string" },
          "drive": { "type": "string" },
          "maps": { "type": "string", "format": "uri" }
        },
        "required": ["name"]
      }
    },
    "offline": {
      "type": "object",
      "properties": {
        "pdfGuideUrl": { "type": "string" },
        "lastCached": { "type": "string" }
      }
    }
  },
  "required": ["sport", "tournament", "team", "venue", "scheduleStatus", "updates", "contacts", "checklist"],
  "additionalProperties": false
}
