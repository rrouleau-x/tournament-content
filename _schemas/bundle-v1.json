{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rrouleau-x.github.io/tournament-content/_schemas/bundle-v1.json",
  "title": "Tournament Guide Bundle — Contract v1",
  "description": "The compiled data.json contract consumed by the Sporting Jax Guide PWA (app contract v1). Content modules compile into this shape. Fields marked required are mandatory for a publishable guide; everything else is optional and renders as an empty/absent state in the app. Dates are ISO-8601 (YYYY-MM-DD) and validated as real calendar dates by the pipeline.",
  "type": "object",
  "properties": {
    "sport": {
      "type": "string",
      "enum": ["soccer", "baseball", "basketball", "football", "lacrosse", "volleyball", "other"]
    },
    "sportConfig": {
      "type": "object",
      "description": "Sport-specific labels so the same app shell works for any sport.",
      "properties": {
        "teamLabel": { "type": "string" },
        "fieldLabel": { "type": "string" },
        "matchLabel": { "type": "string" },
        "uniformLabel": { "type": "string" },
        "cleatsLabel": { "type": "string" }
      },
      "required": ["teamLabel", "fieldLabel", "matchLabel"],
      "additionalProperties": false
    },
    "tournament": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string" },
        "organizer": { "type": "string" },
        "dates": {
          "type": "object",
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          },
          "required": ["start", "end"],
          "additionalProperties": false
        }
      },
      "required": ["name", "dates"],
      "additionalProperties": false
    },
    "team": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string" },
        "colors": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "logo": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "venue": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "additionalProperties": false
        },
        "mapsUrl": { "type": "string", "format": "uri" },
        "parking": { "type": "string" },
        "fields": {
          "type": "object",
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "surface": { "type": "string" },
            "map": { "type": "string", "format": "uri" },
            "layoutNotes": {
              "type": "object",
              "description": "Free-form field-number → note map (dynamic keys).",
              "additionalProperties": { "type": "string" }
            }
          },
          "required": ["count"],
          "additionalProperties": false
        },
        "amenities": {
          "type": "object",
          "properties": {
            "concessions": { "type": "boolean" },
            "restrooms": { "type": "boolean" },
            "shade": { "type": "string" },
            "aed": { "type": "boolean" },
            "playground": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "required": ["name", "address"],
      "additionalProperties": false
    },
    "games": {
      "type": "array",
      "description": "Empty until schedule releases. When a game exists, date/time/opponent are mandatory — 'when and where does my kid play' is the highest-stakes field in the bundle.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "time": { "type": "string", "minLength": 1 },
          "opponent": { "type": "string", "minLength": 1 },
          "venue": { "type": "string" },
          "field": { "type": "string" },
          "type": { "type": "string", "enum": ["group", "quarterfinal", "semifinal", "final", "showcase"] }
        },
        "required": ["date", "time", "opponent"],
        "additionalProperties": false
      }
    },
    "scheduleStatus": {
      "type": "string",
      "enum": ["pending", "partial", "confirmed"]
    },
    "scheduleExpected": { "type": "string" },
    "hotels": {
      "type": "object",
      "properties": {
        "stayToPlay": { "type": "boolean" },
        "portal": { "type": "string", "format": "uri" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the rates were last researched/verified (ET). Prices change daily — the app shows this so parents know to confirm on the portal."
        },
        "official": {
          "type": "array",
          "description": "3-5 is guide guidance, not a contract limit — do not re-add maxItems here.",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "chain": { "type": "string" },
              "rate": { "type": "string" },
              "total2Nights": { "type": "string" },
              "rooms": { "type": "integer", "minimum": 0 },
              "drive": { "type": "string", "pattern": "^\\d+(\\.\\d+)?\\s*(mi|miles?)\\s*[·•\\-–—]\\s*~?\\d+\\s*min$" },
              "route": { "type": "string" },
              "amenities": { "type": "array", "items": { "type": "string" } },
              "rating": { "type": "number", "minimum": 0, "maximum": 5 },
              "bestValue": { "type": "boolean" },
              "bookUrl": { "type": "string", "format": "uri" }
            },
            "required": ["name", "drive"],
            "additionalProperties": false
          }
        },
        "nonOfficial": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "chain": { "type": "string" },
              "drive": { "type": "string", "pattern": "^\\d+(\\.\\d+)?\\s*(mi|miles?)\\s*[·•\\-–—]\\s*~?\\d+\\s*min$" },
              "note": { "type": "string" }
            },
            "required": ["name", "drive"],
            "additionalProperties": false
          }
        }
      },
      "required": ["stayToPlay"],
      "additionalProperties": false
    },
    "weather": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "forecastLink": { "type": "string" },
        "source": { "type": "string", "description": "Provenance of this forecast (e.g. National Weather Service)" },
        "sourceApiUrl": { "type": "string", "format": "uri", "description": "Machine-readable source API URL (provenance, not a parent link)" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the forecast was fetched" }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "fullLink": { "type": "string", "format": "uri" },
        "keyRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            },
            "required": ["label", "value"],
            "additionalProperties": false
          }
        },
        "tiebreakers": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["info", "warning", "alert", "success"] },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "time": { "type": "string" },
          "posted": { "type": "string" },
          "actionRequired": { "type": "boolean" }
        },
        "required": ["type", "title"],
        "additionalProperties": false
      }
    },
    "contacts": {
      "type": "object",
      "properties": {
        "manager": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "role": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string", "format": "email" }
          },
          "additionalProperties": false
        },
        "coach": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "role": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string", "format": "email" }
          },
          "additionalProperties": false
        },
        "teamManagers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "phone": { "type": "string" },
              "email": { "type": "string", "format": "email" }
            },
            "additionalProperties": false
          }
        },
        "premierStaff": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "phone": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "tournamentDirector": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string", "format": "email" },
            "phone": { "type": "string" }
          },
          "additionalProperties": false
        },
        "emergency": { "type": "string" }
      },
      "additionalProperties": false
    },
    "venueRules": {
      "type": "object",
      "properties": {
        "tents": { "type": "string" },
        "pets": { "type": "string" },
        "foodCooler": { "type": "string" },
        "chairs": { "type": "string" },
        "alcohol": { "type": "string" },
        "smoking": { "type": "string" }
      },
      "additionalProperties": false
    },
    "checklist": {
      "type": "object",
      "properties": {
        "player": { "type": "array", "items": { "type": "string" } },
        "weather": { "type": "array", "items": { "type": "string" } },
        "parent": { "type": "array", "items": { "type": "string" } },
        "emergency": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "nearby": {
      "type": "object",
      "description": "Nearby resources. Keys are semantic slugs (urgentCare, target, dicks, coffee); values are place objects.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "address": { "type": "string" },
          "phone": { "type": "string" },
          "drive": { "type": "string" },
          "maps": { "type": "string", "format": "uri" }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "offline": {
      "type": "object",
      "properties": {
        "pdfGuideUrl": { "type": "string" },
        "lastCached": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["sport", "tournament", "team", "venue", "scheduleStatus", "updates", "contacts", "checklist"],
  "additionalProperties": false
}
